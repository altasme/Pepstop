{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pepstop",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-11",
  "alias": { "@static": "./worker/static-assets.ts" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": true
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "pepstop_db", "database_id": "78312565-f645-4575-a19e-59fe07626ac1", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "pepstop-files" }],
  "observability": { "enabled": true }
}
