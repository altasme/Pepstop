{
  "name": "pepstop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite-react-ssg build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "audit:content": "node scripts/audit.mjs",
    "deploy": "npm run build && wrangler deploy",
    "cf:preview": "npm run build && wrangler dev",
    "cf:dry": "npm run build && wrangler deploy --dry-run",
    "deploy:inline": "npm run build && node scripts/deploy-inline.mjs && wrangler deploy --config .worker-inline/wrangler.jsonc"
  },
  "dependencies": {
    "@fontsource/hanken-grotesk": "^5.3.0",
    "lucide-react": "^1.71.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "vite-react-ssg": "^0.9.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "wrangler": "^4.160.0"
  }
}
